NODE_ENV=development
PORT=5000
MONGO_CONNECTION=mongodb://127.0.0.1:27017/digitalbank

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=10m
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=1h

NIBSS_API_KEY=replace-with-nibss-api-key
NIBSS_API_SECRET=replace-with-nibss-api-secret
NIBSS_BASE_URL=https://nibssbyphoenix.onrender.com

# Optional live integration-test values
NIBSS_INTEGRATION=false
NIBSS_TEST_ACCOUNT_NUMBER=replace-with-sandbox-account-number
NIBSS_TEST_BVN=replace-with-sandbox-bvn
# Or use NIBSS_TEST_NIN instead of NIBSS_TEST_BVN.
