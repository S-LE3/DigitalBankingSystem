{
  "name": "RaiBankDatabase",
  "version": "1.0.0",
  "description": "Rain Digital Bank",
  "main": "app.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "test:integration": "node --test Tests/nibss.integration.test.js",
    "migrate:payments": "node scripts/migrateLegacyPayments.js",
    "start:prod": "NODE_ENV=production nodemon server.js",
    "debug": "ndb server.js",
    "watch:js": "parcel watch --target browserBundle",
    "build:js": "parcel build --target browserBundle"
  },
  "browserBundle": "./public/js/bundle.js",
  "targets": {
    "browserBundle": {
      "source": "./public/js/index.js",
      "context": "browser"
    }
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "17.2.3",
    "express": "^4.22.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "hpp": "0.2.3",
    "html-to-text": "9.0.5",
    "jsonwebtoken": "9.0.2",
    "mongodb": "^7.5.0",
    "mongoose": "^8.24.4",
    "morgan": "^1.12.0",
    "node-domexception": "file:./vendor/node-domexception",
    "nodemailer": "^10.0.1",
    "nodemon": "^3.1.14",
    "notosans-fontface": "^1.3.0",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "parcel": "^2.16.4",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "glob": "^13.0.6",
    "node-domexception": "$node-domexception",
    "exceljs": {
      "archiver": "^7.0.1",
      "fast-csv": "^5.0.5",
      "unzipper": "^0.12.3",
      "uuid": "^11.1.0"
    }
  },
  "engines": {
    "node": "^24"
  },
  "allowScripts": {
    "node-gyp-build-optional-packages@5.1.1": true,
    "node-gyp-build-optional-packages@5.2.2": true
  }
}
